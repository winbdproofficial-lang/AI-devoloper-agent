# Copy this file to .env and fill in real values locally.
# NEVER commit the real .env file. NEVER put real secrets in this file.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL=

# --- Auth ---
JWT_SECRET=
SESSION_SECRET=

# --- Third-party API providers ---
API_PROVIDER_KEY=
API_PROVIDER_BASE_URL=

# --- GitHub (only if the agent needs API access, not git-CLI credentials) ---
GITHUB_TOKEN=

# --- Deployment ---
DEPLOY_ENV=development
